#!/bin/bash
#PBS -N H3_healthy_a3
#PBS -q default
#PBS -l nodes=1:ppn=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /home/nishioka/render_scratch/H3_healthy_a3.pbslog
# Fix: added ur1-ur3=0 (DOF 4-6) to all 4 BC sets to prevent ZERO PIVOT
# from outer skin rigid-body rotation (Tie-AdhOuter-OuterSkin revert issue)
cd /home/nishioka/Payload2026/abaqus_root_archive
export PATH=/home/nishioka/DassaultSystemes/SIMULIA/Commands:$PATH
export TMPDIR=/home/nishioka/render_scratch
j=H3_healthy_a3
rm -f $j.odb $j.lck $j.sta $j.msg 2>/dev/null
echo "[$(date '+%F %T')] solving $j on $(hostname)"
abq2024 job=$j input=H3_healthy_a3.inp cpus=1 scratch=$TMPDIR interactive
echo "===STA==="; tail -10 $j.sta 2>/dev/null
echo "H3_healthy_a3_DONE $(date '+%F %T')"
