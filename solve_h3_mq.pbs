#!/bin/bash
#PBS -N H3_mq
#PBS -q default
#PBS -l nodes=1:ppn=24
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o /home/nishioka/render_scratch/H3_mq.pbslog
cd /home/nishioka/Payload2026
export PATH=/home/nishioka/DassaultSystemes/SIMULIA/Commands:$PATH
export TMPDIR=/home/nishioka/render_scratch
for j in H3_healthy_mq H3_debond_mq H3_fod_mq H3_impact_mq H3_delam_mq H3_acoustic_mq H3_Thermal_t2; do
  echo "[$(date '+%F %T')] solving $j on $(hostname)"
  rm -f "$j.odb" "$j.lck" 2>/dev/null
  abq2024 job="$j" input="$j.inp" cpus=1 memory="85gb" interactive scratch="$TMPDIR"
  echo "[$(date '+%F %T')] $j rc=$?"
done
echo "H3MQ_DONE $(date '+%F %T')"
